{
  "name": "minecraft-soulbot",
  "version": "1.0.0",
  "private": true,
  "description": "A persistent Minecraft Java companion with deterministic control and optional model advice",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint src && tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "import:soul": "tsx src/storage/importLegacy.ts"
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "mineflayer": "4.39.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "2.4.5",
    "mineflayer-pvp": "1.3.2",
    "pino": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "pngjs": "^7.0.0",
    "vec3": "^0.1.10",
    "zod": "^4.0.0"
  },
  "overrides": {
    "@azure/msal-node": {
      "uuid": "^11.1.1"
    },
    "yggdrasil": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
