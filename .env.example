# Java server connection. Use microsoft for a normal online-mode server.
# Run named bots with `npm start -- --instance cedar`. Per-bot settings go in .env.cedar.
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=SoulBot
MC_VERSION=1.20.1
MC_AUTH=offline
# Comma-separated Java usernames authorized to control the bot. Empty denies mutations.
# Replace with your username before joining. Only use offline auth on trusted private servers.
MC_ADMINS=
# Standalone defaults. Named instances use per-instance paths unless overridden for that bot.
MC_AUTH_CACHE=./data/auth

# Planner interval, action deadline, and sensing radius (blocks).
THINK_INTERVAL_MS=3000
ACTION_TIMEOUT_MS=15000
PERCEPTION_RADIUS=24
# Need scores from 0 to 100; retreat when safety is below SAFETY_TRIGGER.
HUNGER_TRIGGER=65
SAFETY_TRIGGER=35
SLEEP_TRIGGER=60
# If true, bot tries to sleep once each Minecraft night even with low sleep debt.
SLEEP_EVERY_NIGHT=true

# Real sleep + once-per-world-night consolidation. Drift is bounded even if configured higher.
ENABLE_SLEEP=true
MAX_TRAIT_DRIFT_PER_SLEEP=0.02
MAX_TRUST_DELTA_PER_SLEEP=0.05
MAX_VALUE_DELTA_PER_SLEEP=0.01
ALLOW_CORE_VALUE_CHANGE=false

# Ollama receives addressed chat and, in survival mode, game observations. Use the local address for on-device inference.
LOCAL_LLM_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_MS=30000
OLLAMA_CONTEXT=4096

# Opt-in: allows bounded mining, crafting, and construction in a Survival Overworld.
AUTONOMY_ENABLED=false
AUTONOMY_VISION=true
AUTONOMY_RADIUS=28
AUTONOMY_REQUIRE_AI=true
AUTONOMY_MODEL_TIMEOUT_MS=12000
# Optional same-Mac team. Set both to matching values for the bots that share a build.
# TEAM_ID=homestead
# TEAM_HOME=120,68,-45
# Optional reflective pause action (off by default to keep the bot active).
REFLECTION_ENABLED=false

# Local monitor web page (thoughts, stats, goals, inventory, events).
MONITOR_ENABLED=true
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8787

# Cloud sleep-only advice. Never sends chat, player names, coordinates, or goals.
# CLOUD_PROVIDER: openrouter, openai, or compatible; configure CLOUD_BASE_URL accordingly.
CLOUD_SLEEP_ENABLED=false
CLOUD_PROVIDER=openrouter
CLOUD_BASE_URL=https://openrouter.ai/api/v1
CLOUD_MODEL=openai/gpt-4.1
CLOUD_API_KEY=
CLOUD_TIMEOUT_MS=7000

# Standalone Markdown save. Named instances default to ./data/instances/<id>/soul.md.
STATE_PATH=./soul.md
STM_CAPACITY=300
# Set for reproducible pacing; leave blank to seed from Node crypto.
RNG_SEED=

LOG_LEVEL=info
LOG_PRETTY=true
AUDIT_LOG_SLEEP_DIFFS=true
